# Replace every placeholder before starting the stack. Use unique, strong passwords.
ELASTIC_PASSWORD=elastic
KIBANA_SYSTEM_PASSWORD=replace_with_a_strong_kibana_password

# Each Kibana encryption key must be at least 32 characters long.
KIBANA_ENCRYPTEDSAVEDOBJECTS_KEY=replace_with_a_unique_key_of_32_characters_minimum
KIBANA_SECURITY_SESSION_KEY=replace_with_a_unique_key_of_32_characters_minimum
KIBANA_REPORTING_KEY=replace_with_a_unique_key_of_32_characters_minimum
